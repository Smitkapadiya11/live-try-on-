# Your permanent Decart key (starts with dct_). Server-only — the browser only
# ever sees 60-second client tokens minted by /api/token.
DECART_API_KEY=

# Optional: require this code before a session can start. Strongly recommended
# on a public URL — every live second is billed to your Decart credits.
ACCESS_CODE=

# Hard cap for one live session, in seconds (Decart ends it server-side too).
SESSION_SECONDS=300

# "1" = Decart fast mode: lower latency, billed at 2x.
FAST_MODE=0
